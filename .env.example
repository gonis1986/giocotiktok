# ==============================================================================
# CONFIGURAZIONE ANDROBS TIKTOK LIVE BRIDGE
# Copia questo file in .env e inserisci le tue configurazioni reali
# ==============================================================================

# 1. Username del canale TikTok da monitorare (senza la @)
TIKTOK_USER=tuo_username_tiktok

# 2. URL del tuo endpoint web dove risiede tiktok_events.php
ANDROBS_BACKEND_URL=https://www.tuodominio.com/tiktok_events.php

# 3. Token segreto per autorizzare il bridge ad inviare eventi al backend PHP
ANDROBS_BRIDGE_TOKEN=genera_una_chiave_segreta_molto_lunga_qui_2026

# 4. Credenziali FTP per il deploy automatico
FTP_HOST=ftp.tuodominio.com
FTP_USER=tuo_utente_ftp
FTP_PASS=tua_password_ftp
